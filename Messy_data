#novacart:Catalog
#ns:Schema
#products:Table Name
CREATE TABLE novacart.ns.products (
    product_id    INT           NOT NULL PRIMARY KEY,
    product_name  VARCHAR(100) ,
    category      VARCHAR(100)  ,
    price         VARCHAR(30)   , 
    updated_at    DATE
);
#ORDERS:Table Name
CREATE TABLE novacart.ns.orders (
    order_id      INT           NOT NULL PRIMARY KEY,
    customer_id   INT                , 
    product_id    INT                 ,
    order_status  VARCHAR(50)         ,
    order_amount  VARCHAR(30)   ,      
    created_at    DATE    ,
    updated_at    DATE    ,
    CONSTRAINT FK_Orders_Products FOREIGN KEY (product_id) 
        REFERENCES ns.products(product_id)
);

# payments:Table name
CREATE TABLE ns.payments (
    payment_id     INT NOT NULL PRIMARY KEY,
    order_id      INT ,          
    payment_status VARCHAR(50) ,  
    paid_amount    VARCHAR(30) ,  
    processed_at   DATE ,
    CONSTRAINT FK_Payments_Orders FOREIGN KEY (order_id) 
        REFERENCES ns.orders(order_id)
);

INSERT INTO novacart.ns.products
SELECT
    1000 + id AS product_id,

    CASE
        WHEN id % 20 = 0 THEN NULL
        WHEN id % 15 = 0 THEN concat('   Product ', id, '   ')
        WHEN id % 11 = 0 THEN concat('PRODUCT-', id)
        WHEN id % 9  = 0 THEN concat('Prod_', id)
        ELSE concat('Product ', id)
    END AS product_name,

    CASE
        WHEN id % 18 = 0 THEN 'ELECTRNICS'
        WHEN id % 14 = 0 THEN 'lifestyle'
        WHEN id % 10 = 0 THEN 'FITNESS'
        WHEN id % 7  = 0 THEN 'electronics'
        ELSE 'Electronics'
    END AS category,

    CASE
        WHEN id % 25 = 0 THEN '??'
        WHEN id % 16 = 0 THEN concat('$', 10 + (id % 90), '.00')
        WHEN id % 13 = 0 THEN concat(10 + (id % 90), ',00')
        WHEN id % 8  = 0 THEN concat(' ', 10 + (id % 90), '.00 ')
        ELSE concat(10 + (id % 90), '.00')
    END AS price,

    date_add('2026-02-01', id) AS updated_at

FROM range(1, 121);

INSERT INTO novacart.ns.orders
SELECT
    200000 + id AS order_id,

    CASE
        WHEN id % 40 = 0 THEN NULL
        ELSE 5000 + (id % 200)
    END AS customer_id,

    1001 + ((id - 1) % 120) AS product_id,

    CASE
        WHEN id % 33 = 0 THEN NULL
        WHEN id % 22 = 0 THEN ''
        WHEN id % 15 = 0 THEN 'shipped'
        WHEN id % 9  = 0 THEN 'cancelled'
        ELSE 'PLACED'
    END AS order_status,

    CASE
        WHEN id % 45 = 0 THEN '0.00'
        WHEN id % 28 = 0 THEN 'N/A'
        WHEN id % 17 = 0 THEN concat('$', 50 + (id % 100), '.00')
        WHEN id % 12 = 0 THEN concat(50 + (id % 100), ',00')
        ELSE concat(50 + (id % 100), '.00')
    END AS order_amount,

    date_add('2026-02-01', CAST(id / 1440 AS INT)) AS created_at,
    date_add('2026-02-01', CAST(id / 1440 AS INT)) AS updated_at

FROM range(1, 501);

INSERT INTO ns.payments
SELECT
    900000 + id AS payment_id,

    200000 + id AS order_id,

    CASE
        WHEN id % 35 = 0 THEN NULL
        WHEN id % 18 = 0 THEN 'failed'
        WHEN id % 12 = 0 THEN 'pending'
        ELSE 'SUCCESS'
    END AS payment_status,

    CASE
        WHEN id % 40 = 0 THEN '0.00'
        WHEN id % 23 = 0 THEN '??'
        WHEN id % 16 = 0 THEN '$100.00'
        WHEN id % 11 = 0 THEN '100,00'
        ELSE '100.00'
    END AS paid_amount,

    date_add('2026-02-01', CAST(id / 1440 AS INT)) AS processed_at

FROM range(1, 431);
